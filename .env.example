NEXT_PUBLIC_SITE_URL=https://mechanicmatchfl.com

# Supabase client-safe values. These may be read by browser/client code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Supabase server-only value. Never expose this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Server-only M12 review verification and abuse controls.
RESEND_API_KEY=re_replace_me
REVIEW_EMAIL_FROM=MechanicMatchFL Reviews <reviews@mechanicmatchfl.com>
REVIEW_ABUSE_HASH_KEY=replace_with_at_least_32_random_bytes
